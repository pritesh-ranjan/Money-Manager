<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_quick_add_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- 1. Income Button -->
    <ImageButton
        android:id="@+id/btn_quick_add_income"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_notification_btn_income"
        android:src="@drawable/ic_notification_income"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="@string/add_income"
        android:clickable="true"
        android:focusable="true" />

    <!-- 2. Transfer Button -->
    <ImageButton
        android:id="@+id/btn_quick_add_transfer"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_notification_btn_transfer"
        android:src="@drawable/ic_notification_transfer"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="@string/transfer"
        android:clickable="true"
        android:focusable="true" />

    <!-- 3. Expense Button -->
    <ImageButton
        android:id="@+id/btn_quick_add_expense"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_notification_btn_expense"
        android:src="@drawable/ic_notification_expense"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="@string/add_expense"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
